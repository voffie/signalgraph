{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "watch": "pnpm -r --parallel watch",
    "check": "pnpm -r check",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest --coverage",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.51.0",
    "@effect/vitest": "^4.0.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "effect": "^4.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.20.0"
}
