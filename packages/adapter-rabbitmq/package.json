  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/adapter-rabbitmq"
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
