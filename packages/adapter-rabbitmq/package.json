{
  "name": "@signalgraph/adapter-rabbitmq",
  "version": "0.0.0",
  "description": "RabbitMQ broker adapter for SignalGraph",
  "keywords": [
    "adapter",
    "effect",
    "message-broker",
    "rabbitmq",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
