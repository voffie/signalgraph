{
  "name": "@signalgraph/adapter-rabbitmq",
  "version": "0.0.0",
  "description": "RabbitMQ broker adapter for SignalGraph",
  "keywords": [
    "adapter",
    "effect",
    "message-broker",
    "rabbitmq",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/adapter/rabbitmq"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "^4.0.3",
    "@opentelemetry/api": "^1.9.1",
    "amqplib": "^2.2.0",
    "signalgraph": "workspace:^"
  },
  "devDependencies": {
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/node": "^26.6.4",
    "effect": "^4.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.3"
  }
}
