{
  "name": "@signalgraph/adapter-rabbitmq",
  "version": "0.0.1",
  "description": "RabbitMQ broker adapter for SignalGraph",
  "keywords": [
    "adapter",
    "amqp",
    "effect",
    "event-driven",
    "message-broker",
    "rabbitmq",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/adapter/rabbitmq"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.1.5",
    "amqplib": "^2.2.0",
    "signalgraph": "workspace:^"
  },
  "devDependencies": {
    "@testcontainers/rabbitmq": "^12.2.0",
    "@testcontainers/toxiproxy": "^12.2.0",
    "@types/node": "^26.6.4",
    "effect": "^4.1.5",
    "testcontainers": "^12.2.0"
  },
  "peerDependencies": {
    "effect": "^4.1.5",
    "signalgraph": "workspace:^"
  }
}
