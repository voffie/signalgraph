{
  "name": "@signalgraph/core",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./Message": "./src/Message.ts",
    "./Consumer": "./src/Consumer.ts",
    "./Topology": "./src/Topology.ts",
    "./Driver": "./src/Driver.ts",
    "./Envelope": "src/Envelope.ts",
    "./Metadata": "src/Metadata.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./Message": {
        "types": "./dist/Message.d.mts",
        "import": "./dist/Message.mjs"
      },
      "./Consumer": {
        "types": "./dist/Consumer.d.mts",
        "import": "./dist/Consumer.mjs"
      },
      "./Topology": {
        "types": "./dist/Topology.d.mts",
        "import": "./dist/Topology.mjs"
      },
      "./Driver": {
        "types": "./dist/Driver.d.mts",
        "import": "./dist/Driver.mjs"
      },
      "./Envelope": {
        "types": "./dist/Envelope.d.mts",
        "import": "./dist/Envelope.mjs"
      },
      "./Metadata": {
        "types": "./dist/Metadata.d.mts",
        "import": "./dist/Metadata.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.83"
  }
}
