{
  "name": "@signalgraph/devtools",
  "version": "0.0.1",
  "description": "Visualize SignalGraph message flows using OpenTelemetry traces",
  "keywords": [
    "effect",
    "observability",
    "opentelemetry",
    "signalgraph",
    "tracing"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist",
    "build",
    "!build/**/*.map"
  ],
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -p tsconfig.integration.json",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:integration": "tsc -p tsconfig.integration.json --noEmit",
    "test": "pnpm -w exec vitest run --project @signalgraph/devtools"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "effect": "^4.1.5",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "effect": "^4.1.5"
  }
}
