{
  "name": "@signalgraph/runtime",
  "version": "0.0.0",
  "description": "Runtime primitives for generated SignalGraph clients",
  "keywords": [
    "effect",
    "event-driven",
    "message-broker",
    "runtime",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/runtime"
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./broker": "./dist/broker.mjs",
    "./telemetry": "./dist/telemetry.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-beta.103",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "signalgraph": "workspace:*"
  },
  "devDependencies": {
    "@signalgraph/adapter-memory": "workspace:*",
    "effect": "4.0.0-beta.103"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.103"
  }
}
