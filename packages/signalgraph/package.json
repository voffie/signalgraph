{
  "name": "signalgraph",
  "version": "1.1.0",
  "description": "Type-safe event-driven architecture for TypeScript built on Effect",
  "keywords": [
    "cli",
    "codegen",
    "effect",
    "event-driven",
    "message-broker",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/signalgraph"
  },
  "bin": {
    "signalgraph": "./bin/signalgraph"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "bin/**"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./broker": "./src/broker/index.ts",
    "./integration": "./src/integration/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./config": "./dist/config/index.js",
      "./runtime": "./dist/runtime/index.js",
      "./broker": "./dist/broker/index.js",
      "./integration": "./dist/integration/index.js"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@opentelemetry/api": "^1.9.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "effect": "^4.1.5"
  },
  "peerDependencies": {
    "effect": "^4.1.5"
  }
}
