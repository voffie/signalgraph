{
  "name": "signalgraph",
  "version": "0.0.0",
  "description": "Type-safe event-driven architecture for TypeScript built on Effect",
  "keywords": [
    "cli",
    "codegen",
    "effect",
    "event-driven",
    "message-broker",
    "typescript"
  ],
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/signalgraph"
  },
  "bin": {
    "signalgraph": "./bin/signalgraph"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "bin/**"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./config": "./dist/config/index.js",
      "./runtime": "./dist/runtime/index.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "^4.0.3",
    "@effect/platform-node": "^4.0.3",
    "@opentelemetry/api": "^1.9.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@signalgraph/adapter-memory": "workspace:^",
    "effect": "^4.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.3"
  }
}
