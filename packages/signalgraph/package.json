{
  "name": "signalgraph",
  "version": "0.0.0",
  "description": "Type-safe event-driven architecture for TypeScript built on Effect",
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "Viktor Söderborg",
    "url": "https://github.com/voffie"
  },
  "homepage": "https://github.com/voffie/signalgraph#readme",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**",
    "dist/**",
    "bin/**"
  ],
  "bin": {
    "signalgraph": "./bin/signalgraph"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "tsx": "4.23.0",
    "@effect/platform-node": "4.0.0-beta.98"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.98"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.98"
  },
  "keywords": [
    "effect",
    "typescript",
    "event-driven",
    "message-broker",
    "codegen",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voffie/signalgraph.git",
    "directory": "packages/signalgraph"
  },
  "bugs": {
    "url": "https://github.com/voffie/signalgraph/issues"
  }
}
