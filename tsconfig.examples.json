{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "examples",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "examples/*/src/**/*.ts",
    "examples/*/generated/**/*.ts",
    "examples/*/alchemy.run.ts",
    "examples/*/signalgraph.config.ts"
  ],
  "references": [{ "path": "tsconfig.packages.json" }, { "path": "packages/devtools/tsconfig.integration.json" }]
}
