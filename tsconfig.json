{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/memory"
    }
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}
